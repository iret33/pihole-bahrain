[Unit]
Description=Nay scheduler (nay timers and bedtime)
Documentation=https://github.com/iret33/nay
After=pihole-FTL.service network-online.target
Wants=pihole-FTL.service network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/nay/bin/nay run
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
